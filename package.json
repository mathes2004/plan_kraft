{
  "name": "plan-kraft",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/serve-pages.mjs",
    "test:pages": "playwright test --config=playwright.pages.config.ts",
    "sync:watch": "node scripts/auto-sync.mjs --watch",
    "sync:now": "node scripts/auto-sync.mjs --once",
    "sync:check": "node scripts/auto-sync.mjs --check",
    "sync:pause": "node scripts/auto-sync.mjs --pause",
    "sync:resume": "node scripts/auto-sync.mjs --resume",
    "sync:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-auto-sync.ps1",
    "sync:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-auto-sync.ps1 -Uninstall",
    "start": "next start",
    "lint": "eslint src tests e2e",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests e2e *.ts *.json *.md eslint.config.js"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "type": "module"
}
